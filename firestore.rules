rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 機種データ：誰でも読める
    match /phones/{phoneId} {
      allow read: if true;
      allow write: if request.auth != null;

      match /reviews/{reviewId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
      match /influencerReviews/{reviewId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
      match /likes/{userId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // AIレビューキャッシュ：誰でも読める
    match /aiReviewCache/{phoneId} {
      allow read: if true;
      allow write: if true;
    }

    // 選択統計：誰でも読み書きOK（ログイン不要）
    match /phoneSelectStats/{phoneId} {
      allow read, write: if true;
    }
    match /compareComboStats/{comboId} {
      allow read, write: if true;
    }

    // 投票：ログイン必須・本人のみ
    match /userVotes/{userId}/phones/{phoneId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
